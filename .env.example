# Copy to .env.local and fill in. Never commit .env.local.

# --- Store identity -------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Emmason Mobile Phones, Tech & Gadgets"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number that receives orders, in international format, digits only.
# e.g. 2348012345678 for +234 801 234 5678
NEXT_PUBLIC_WHATSAPP_NUMBER="2349065755314"

# WhatsApp Channel invite link wholesale leads are sent to join after they
# claim their 5% off (WhatsApp app -> Updates tab -> + -> New channel to
# create one). Looks like https://whatsapp.com/channel/xxxxxxxxxxxxxxxxx.
# Leave unset and the popup/form fall back to a prefilled WhatsApp DM.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=""

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Paystack -------------------------------------------------------------
# Test keys start with pk_test_ / sk_test_. Swap for live keys when you go live.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxx"

# --- Order alert email ------------------------------------------------------
# Resend API key used to email the shop owner the moment a customer places an
# order. Sends today from Resend's shared onboarding domain
# (onboarding@resend.dev) since no verified Emmason domain exists yet — swap
# the "from" address in src/lib/order-alert-email.ts for a verified Emmason
# address once one is set up in Resend.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# The owner's own inbox that order alerts are sent to. Not the storefront's
# public contact address (see src/lib/site.ts) — this is where fulfilment
# alerts land.
ORDER_ALERT_EMAIL="owner@example.com"
